{
  "manifest_version": 3,
  "name": "Clostore Pinduoduo Parser",
  "version": "1.2.0",
  "description": "Считывает видимые карточки Pinduoduo и выполняет разрешённые текстовые и фото-команды поиска AI-агента из CloStore.",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "https://mobile.yangkeduo.com/*", "https://*.pinduoduo.com/*", "https://*.yangkeduo.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Clostore Pinduoduo Parser",
    "default_popup": "popup.html"
  }
}
